# Copy this file outside version control, replace placeholders, then source it.
export DCE_PIPELINE_ROOT="/path/to/private/workspace"
export DCE_PHASE_TABLE="/path/to/private/phase_mapping.xlsx"
export DCE_NIFTI_OUTPUT_ROOT="/path/to/private/nifti_output"
export DCE_NIFTI_ROOT="/path/to/private/nifti_output/NIFTI_RAW"
export DCE_SEGMENTATION_ROOT="/path/to/private/segmentation_output"
export DCE_METADATA_XLSX="/path/to/private/metadata.xlsx"
export DCE_MANUAL_RANGES_DOCX="/path/to/private/manual_ranges.docx"
export DCE_STEP5_OUTPUT="/path/to/private/step5_output"
export DCE_STEP6_OUTPUT="/path/to/private/step6_multiphase_mips"

# Optional local files containing subject-specific exceptions. Never commit
# populated versions because they may contain protected identifiers.
export DCE_STACKED_CONFIG="/path/to/private/stacked_cases.json"
export DCE_SLICE_RULES_JSON="/path/to/private/slice_rules.json"
export DCE_SECONDARY_ONLY_IDS=""
